pkgbase = linux-rpi
	pkgdesc = Linux (Raspberry Pi fork)
	pkgver = 7.3.6
	pkgrel = 1
	url = https://www.raspberrypi.com/
	arch = aarch64
	license = GPL-2.0 WITH Linux-syscall-note
	makedepends = bc
	makedepends = dtc
	makedepends = perl
	makedepends = python
	makedepends = zstd
	options = !debug
	options = !strip
	source = https://github.com/raspberrypi/linux/archive/99dc5c58063750a5cb675d9f15cd074036e2d72e.tar.gz
	sha256sums = 95999513a6f83e34981b832b470bc5c5e6cb753049309300ec59e46612cc66dd

pkgname = linux-rpi
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-rpi-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = trusted-firmware-a-rpi4: PSCI and kexec support on the Raspberry Pi 4
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = kernel
	provides = NTSYNC-MODULE
	provides = WIREGUARD-MODULE

pkgname = linux-rpi-headers
	pkgdesc = Headers and scripts for building modules for the Linux (Raspberry Pi fork) kernel
	depends = bc
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
