pkgbase = linux-rpi
	pkgdesc = Linux (Raspberry Pi fork)
	pkgver = 7.3.0
	pkgrel = 1
	url = https://www.raspberrypi.com/
	arch = aarch64
	license = GPL-2.0 WITH Linux-syscall-note
	makedepends = bc
	makedepends = dtc
	makedepends = perl
	makedepends = python
	makedepends = zstd
	options = !debug
	options = !strip
	source = https://github.com/raspberrypi/linux/archive/3e14c429f6c0b8e10d5a2dad345e8a7011be6dfb.tar.gz
	sha256sums = 3cf12b5b61e3c7e58a59505cc51b26010a4aca423bf363fd871d9aadd5cadd19

pkgname = linux-rpi
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-rpi-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = kernel
	provides = NTSYNC-MODULE
	provides = WIREGUARD-MODULE

pkgname = linux-rpi-headers
	pkgdesc = Headers and scripts for building modules for the Linux (Raspberry Pi fork) kernel
	depends = bc
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
